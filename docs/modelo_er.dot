digraph ER { rankdir=LR; graph [fontname="Helvetica", bgcolor="white", pad=0.4, nodesep=0.35, ranksep=1.1]; node [shape=plain, fontname="Helvetica", fontsize=10]; edge [color="#5b6f8a", arrowsize=0.7, fontsize=8, fontname="Helvetica"];
 roles [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#0b2650"><font color="white"><b>roles</b></font></td></tr><tr><td align="left">id_rol (PK)<br align="left"/>nombre</td></tr></table>>];
 usuarios [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#0b2650"><font color="white"><b>usuarios</b></font></td></tr><tr><td align="left">id_usuario (PK)<br align="left"/>usuario, correo, password<br align="left"/>fk_rol (FK)</td></tr></table>>];
 agentes [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#18488e"><font color="white"><b>agentes</b></font></td></tr><tr><td align="left">id_agente (PK)<br align="left"/>nombre, telefono, correo, activo<br align="left"/>fk_usuario (FK)</td></tr></table>>];
 clientes [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#18488e"><font color="white"><b>clientes</b></font></td></tr><tr><td align="left">id_cliente (PK)<br align="left"/>nombre, telefono, correo, profesion<br align="left"/>fk_usuario (FK)</td></tr></table>>];
 propietarios [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#18488e"><font color="white"><b>propietarios</b></font></td></tr><tr><td align="left">id_propietario (PK)<br align="left"/>nombre, telefono, correo<br align="left"/>fk_usuario (FK)</td></tr></table>>];
 tipo [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#1689a9"><font color="white"><b>tipo_propiedades</b></font></td></tr><tr><td align="left">id_tipo_propiedad (PK)<br align="left"/>nombre</td></tr></table>>];
 propiedades [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#1689a9"><font color="white"><b>propiedades</b></font></td></tr><tr><td align="left">id_propiedad (PK)<br align="left"/>direccion, zona, estado<br align="left"/>precio_venta, precio_arrendamiento<br align="left"/>habitaciones, banos, parqueaderos, area_m2<br align="left"/>foto_url, descripcion<br align="left"/>fk_propietario (FK), fk_tipo_propiedad (FK)</td></tr></table>>];
 fotos [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#1689a9"><font color="white"><b>propiedad_fotos</b></font></td></tr><tr><td align="left">id_foto (PK), url, orden<br align="left"/>fk_propiedad (FK)</td></tr></table>>];
 interesados [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#b78329"><font color="white"><b>interesados</b></font></td></tr><tr><td align="left">id_interesado (PK)<br align="left"/>nombre, edad, correo, ocupacion, telefono<br align="left"/>fk_usuario (FK, opcional)</td></tr></table>>];
 solicitudes [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#b78329"><font color="white"><b>solicitudes_contacto (citas)</b></font></td></tr><tr><td align="left">id_solicitud (PK)<br align="left"/>fecha_contacto, estado, codigo_gestion<br align="left"/>notas, origen<br align="left"/>fk_interesado, fk_propiedad, fk_agente (FK)</td></tr></table>>];
 horarios [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#b78329"><font color="white"><b>horarios_asesor</b></font></td></tr><tr><td align="left">id_horario (PK)<br align="left"/>dia_semana, hora_inicio, hora_fin<br align="left"/>fk_agente (FK)</td></tr></table>>];
 busquedas [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#b78329"><font color="white"><b>busquedas</b></font></td></tr><tr><td align="left">id_busqueda (PK)<br align="left"/>sesion, tipo, presupuesto, zona, modalidad<br align="left"/>fk_usuario (FK, opcional)</td></tr></table>>];
 notif [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#b78329"><font color="white"><b>notificaciones</b></font></td></tr><tr><td align="left">id_notificacion (PK)<br align="left"/>correo_destino, asunto, enviada<br align="left"/>fk_agente (FK)</td></tr></table>>];
 consultas [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#b78329"><font color="white"><b>consultas_propiedad</b></font></td></tr><tr><td align="left">id_consulta (PK), creada_en<br align="left"/>fk_propiedad (FK)</td></tr></table>>];
 contratos [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#1c8c5e"><font color="white"><b>contratos</b></font></td></tr><tr><td align="left">id_contrato (PK)<br align="left"/>fecha_inicio, fecha_final, valor_total<br align="left"/>fk_propiedad, fk_cliente,<br align="left"/>fk_agente, fk_propietario (FK)</td></tr></table>>];
 pagos [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#1c8c5e"><font color="white"><b>pagos</b></font></td></tr><tr><td align="left">id_pago (PK)<br align="left"/>pago_total, fecha_pago<br align="left"/>fk_contrato (FK)</td></tr></table>>];
 remod [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#1c8c5e"><font color="white"><b>remodelaciones</b></font></td></tr><tr><td align="left">id_remodelacion (PK)<br align="left"/>descripcion_obra, presupuesto_estimado<br align="left"/>fechas, estado<br align="left"/>fk_propiedad, fk_cliente, fk_agente (FK)</td></tr></table>>];
 visitas [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#1c8c5e"><font color="white"><b>visitas</b></font></td></tr><tr><td align="left">id_visita (PK), fecha<br align="left"/>fk_cliente, fk_propiedad, fk_agente (FK)</td></tr></table>>];
 auditoria [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#64768d"><font color="white"><b>auditoria</b></font></td></tr><tr><td align="left">id_auditoria (PK)<br align="left"/>usuario, accion, entidad, id_entidad, detalle</td></tr></table>>];
 usuarios->roles; agentes->usuarios; clientes->usuarios; propietarios->usuarios; propiedades->propietarios; propiedades->tipo; fotos->propiedades;
 interesados->usuarios [style=dashed]; busquedas->usuarios [style=dashed]; solicitudes->interesados; solicitudes->propiedades; solicitudes->agentes; horarios->agentes; notif->agentes; consultas->propiedades;
 contratos->propiedades; contratos->clientes; contratos->agentes; contratos->propietarios; pagos->contratos; remod->propiedades; remod->clientes; remod->agentes; visitas->clientes; visitas->propiedades; visitas->agentes;
}
