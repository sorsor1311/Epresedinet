const { verificar } = require('../utils/jwt');

const verificarToken = (req, res, next) => {
  const cabecera = req.headers.authorization || '';
  if (!cabecera.startsWith('Bearer ')) return res.status(401).json({ success: false, message: 'Falta el token de acceso' });
  try { req.usuario = verificar(cabecera.slice(7)); next(); }
  catch { res.status(401).json({ success: false, message: 'Token inválido o expirado' }); }
};

const autorizarRoles = (...permitidos) => (req, res, next) => {
  if (!req.usuario || !permitidos.includes(req.usuario.rol)) return res.status(403).json({ success: false, message: 'Acceso no autorizado para este rol' });
  next();
};

const autenticacionOpcional = (req, _res, next) => {
  const cabecera = req.headers.authorization || '';
  if (cabecera.startsWith('Bearer ')) { try { req.usuario = verificar(cabecera.slice(7)); } catch { /* anónimo */ } }
  next();
};

const limitar = (maximo, ventanaMs = 60_000) => {
  const registro = new Map();
  return (req, res, next) => {
    const ahora = Date.now(), entrada = registro.get(req.ip);
    if (!entrada || ahora > entrada.reinicio) { registro.set(req.ip, { cuenta: 1, reinicio: ahora + ventanaMs }); return next(); }
    if (++entrada.cuenta > maximo) return res.status(429).json({ success: false, message: 'Demasiadas solicitudes. Intenta de nuevo en un minuto.' });
    next();
  };
};

const gestion = [verificarToken, autorizarRoles('Administrador', 'Agente')];
const soloAdmin = [verificarToken, autorizarRoles('Administrador')];
module.exports = { verificarToken, autorizarRoles, autenticacionOpcional, limitar, gestion, soloAdmin };
